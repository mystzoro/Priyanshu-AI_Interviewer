# ============================================================================
# DO NOT put real keys in this file. This file (.env.example) is a template
# meant to be committed to git. Real secrets go in `.env` instead (already
# gitignored — see .gitignore). Copy this file to get started:
#
#   cp .env.example .env
#
# ...then edit the new .env file with your real keys. Never edit the values
# below to real keys, even temporarily -- it's easy to forget and commit them.
# ============================================================================

# Required for full LLM-driven interviews (adaptive follow-ups, natural language,
# structured feedback synthesis). Without this set, the agent runs in a deterministic
# fallback mode -- still fully functional and spec-compliant, but with templated
# questions instead of natural, LLM-generated ones.
ANTHROPIC_API_KEY=

# Optional -- defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional -- Breeth persistent memory layer (https://thebreeth.com).
# When both are set, each completed interview transcript is written to Breeth
# as an episode (and a scored fact) so candidate knowledge accumulates over
# time in the memory graph. Completely optional -- agent works fine without it.
BREETH_API_KEY=
BREETH_PROJECT_ID=

# Optional -- port to listen on
PORT=3000
